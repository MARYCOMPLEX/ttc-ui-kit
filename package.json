{
  "name": "ttc-ui-kit",
  "version": "1.1.1",
  "description": "Team Task Compass UI primitives — small, dependency-free React components.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./adapters": {
      "import": "./adapters/index.js",
      "default": "./adapters/index.js"
    }
  },
  "files": [
    "dist",
    "adapters",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "react": ">=18"
  },
  "keywords": [
    "ui",
    "react",
    "components",
    "design-system"
  ],
  "license": "MIT",
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "scripts": {
    "verify": "node scripts/verify.mjs"
  }
}
